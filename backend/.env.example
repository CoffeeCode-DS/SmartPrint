NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PUBLIC_URL is what actually gets embedded in QR codes — "localhost" in
# a QR code only ever means the phone scanning it, never this machine.
# Leave this commented out: the backend will auto-detect your machine's
# LAN IP on startup and use that instead, so scanning from a phone on the
# same Wi-Fi works with zero configuration. Only set this explicitly if
# you're using a tunnel (ngrok etc.) or the auto-detection picks the
# wrong network interface.
# PUBLIC_URL=https://your-tunnel-url.ngrok.io

# Database
DATABASE_PATH=./data/printsafe.db

# Session behavior (Strict 15-min Zero-Trace TTL)
SESSION_TTL_MINUTES=15
SESSION_EXTENSION_MINUTES=0
SESSION_MAX_EXTENSIONS=0

# Upload / file security (supports high-res scans & mobile camera photos up to 200MB)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=200
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp,heic,heif,avif,doc,docx
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif,image/avif,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Print queue / printer
# Options: 'windows' (Windows Spooler + CIM WMI), 'mock' (simulated), 'system' (Linux/macOS CUPS lp)
PRINTER_MODE=windows
PRINT_MAX_ATTEMPTS=3
MOCK_PRINT_MIN_DELAY_MS=300
MOCK_PRINT_MAX_DELAY_MS=900
MOCK_PRINT_FAILURE_RATE=0.15

# Auth (RBAC)
# JWT_SECRET must be a long random value in any real deployment — generate
# one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=8h
# An ADMIN account is seeded with these credentials the first time the
# server starts and no users exist yet. CHANGE THE PASSWORD in any real use.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=changeme123
# Required invite code for registering staff/operator accounts via LAN
OPERATOR_SIGNUP_CODE=smartprint-operator-key

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=500

# Physical print confirmation & settlement
# SETTLEMENT_PERIOD_MS=3000
# AUTO_VERIFY_PHYSICAL_PRINT=false

# TTL cleanup / crash recovery
CLEANUP_INTERVAL_SECONDS=60
FILE_RETENTION_MINUTES_AFTER_SESSION_END=7
STALE_JOB_TIMEOUT_MINUTES=5
